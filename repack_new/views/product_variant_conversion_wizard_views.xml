<odoo>
    <record id="product_variant_conversion_wizard_form" model="ir.ui.view">
        <field name="name">product.variant.conversion.wizard.form</field>
        <field name="model">product.variant.conversion.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="product_id" required="1"/>                
                <field name="lot_id"/>
                <field name="sale_order_id"/>
                <field name="conversion_lines">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="product_id" readonly="1"/>
                        <field name="quantity"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_convert" string="Convert" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="product_variant_conversion_wizard_action" model="ir.actions.act_window">
        <field name="name">Convert Variants</field>
        <field name="res_model">product.variant.conversion.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_product_variant_conversion_wizard"
              name="Convert Variants"
              parent="stock.menu_stock_inventory_control"
              action="product_variant_conversion_wizard_action"
              sequence="100"/>

    <!-- Remove the button from the product template form -->
