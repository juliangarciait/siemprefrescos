<odoo>
    <data>
        <record id="view_order_form_inherit_credit_limit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.credit.limit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <field name="credito_disponible" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_credit_limit_check" model="ir.rule">
            <field name="name">Credit Limit Check</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>