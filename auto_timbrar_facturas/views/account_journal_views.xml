<odoo>
    <record id="view_account_journal_form_inherit_timbrar_mx" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.timbrar.mx</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="timbrar_mx"/>
            </xpath>
        </field>
    </record>
</odoo>