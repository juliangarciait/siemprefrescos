        <template id="custom_account_report_invoice_with_payments" inherit_id="account.report_invoice_with_payments">
            <xpath expr="//t[@t-name='account.report_invoice_with_payments']" position="inside">
                <t t-call="account.report_invoice">
                    <t t-set="print_with_payments" t-value="True"/>
                    <t t-set="no_of_copies" t-value="2"/>
                    <t t-foreach="no_of_copies+1" t-as="num">
                        <t t-if="num != 0">
                            <t t-set="num_text" t-value="hola"/>
                        </t>
                    </t>
                </t>
            </xpath>
        </template>

