        <template inherit_id="web.external_layout" id="custom_external_layout">
            <xpath expr="//t[@t-if='company.external_report_layout_id']" position="inside">
                <t t-set="num_text" t-value="num_text"/>
            </xpath>
        </template>


        <template inherit_id="account.report_invoice_document" id="custom_report_invoice_document">
            <xpath expr="//t[@t-call='web.external_layout']" position="inside">
                <t t-set="num_text" t-value="num_text"/>
            </xpath>
