<odoo>
    <data>

        <record id="res_config_settings_view_form_invoice" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.invoicing.account.</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='invoicing_settings']" position="after">
                    <block title="Invoice Slips" id="invoicing_slips_settings">
                        <setting id="invoice_slip_test" help="test">
                                <field name="invoice_slip"/>
                                    <div class="mt8">
                                        <button name="%(action_invoice_slips)d" icon="oi-arrow-right"
                                            type="action" string="Manage Invoice Slips" class="btn-link"/>
                                    </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>