<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario del Asistente (Wizard) -->
    <record id="view_sale_invoice_report_wizard_form" model="ir.ui.view">
        <field name="name">sale.invoice.report.wizard.form</field>
        <field name="model">sale.invoice.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Exportar Reporte a Excel">
                <group>
                    <group string="Rango de Fechas (Creación)">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filtros Específicos">
                        <field name="partner_ids" widget="many2many_tags" placeholder="Todos los clientes"/>
                        <field name="order_ids" widget="many2many_tags" placeholder="Todas las órdenes"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_excel" string="Descargar Excel (.xlsx)" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button name="action_view_records" string="Ver en Pantalla" type="object" class="btn-secondary" icon="fa-list"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del Wizard -->
    <record id="action_sale_invoice_report_wizard" model="ir.actions.act_window">
        <field name="name">Exportar Ventas y Facturas a Excel</field>
        <field name="res_model">sale.invoice.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menú del Wizard en Ventas -->
    <menuitem id="menu_sale_invoice_report_wizard"
              name="Exportar Ventas/Facturas a Excel"
              action="action_sale_invoice_report_wizard"
              parent="sale.menu_sale_report"
              sequence="31"/>

</odoo>
